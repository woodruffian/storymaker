{
  "name": "Storymaker",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Storymaker",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "Vue.volar",
        "bradlc.vscode-tailwindcss"
      ]
    }
  },
  "postCreateCommand": "corepack enable && corepack prepare pnpm@11.24.0 --activate && pnpm install && pnpm db:migrate"
}